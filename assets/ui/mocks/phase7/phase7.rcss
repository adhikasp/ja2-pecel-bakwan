/* Phase 7 wireframes (M2): the intro/ending cinema stage and the victory epilogue
 * (docs/ui/intro.md, docs/ui/epilogue.md). Used by assets/ui/mocks/phase7/*.rml and, at build time, by the
 * real screens' own style sheets. Tokens only: no hard-coded colours (assets/ui/tokens.rcss). */

/* ================================================================ intro / ending cinema stage */
.in { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--c-void); }
.in-stage { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; }
.in-video {
	width: 1280dp; height: 720dp; max-width: 80%; max-height: 80%;
	background-color: var(--c-inset); border: var(--border) var(--c-line);
	display: flex; align-items: center; justify-content: center;
}
.in-video-note { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 2dp; font-size: var(--fs-md); color: var(--c-text-faint); }
.in-card { display: flex; flex-direction: column; align-items: center; gap: var(--sp-3); }
.in-card-count { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-display); text-transform: uppercase; letter-spacing: 6dp; color: var(--c-text-strong); }
.in-card-note { font-size: var(--fs-md); color: var(--c-text-faint); text-transform: uppercase; letter-spacing: 2dp; }

/* the fading hint bar: scene dots and position on the left, the skip hint on the right */
.in-chrome {
	position: absolute; left: var(--sp-4); right: var(--sp-4); bottom: var(--sp-5);
	display: flex; align-items: center; justify-content: space-between;
	padding: var(--sp-3) var(--sp-4); background-color: var(--c-scrim); border: var(--border) var(--c-line);
}
.in-scenes { display: flex; align-items: center; }
.in-dot { display: block; width: 8dp; height: 8dp; margin-right: var(--sp-2); border-radius: 4dp; background-color: var(--c-line-2); }
.in-dot.on { background-color: var(--c-accent); }
.in-count { margin-left: var(--sp-3); font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-text); }
.in-hint { font-size: var(--fs-sm); color: var(--c-text-dim); }
.in-chrome.compact .in-hint { font-size: var(--fs-xs); }
.in-track { position: absolute; left: 0; right: 0; bottom: 0; height: 2dp; background-color: var(--c-line); }
.in-track .fill { display: block; height: 2dp; background-color: var(--c-accent); }

/* ================================================================ victory epilogue */
.ep { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--c-void); }
.ep-root {
	position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow-y: auto;
	display: flex; flex-direction: column; align-items: center;
	padding: var(--sp-5) var(--sp-5);
}
.ep-col { display: block; width: 1360dp; max-width: 100%; margin: auto 0; }
.ep-bg { position: absolute; left: 0; right: 0; top: 0; bottom: 0; decorator: image(gen-mottle repeat); opacity: 0.25; }
.ep-head { display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-5); }
.ep-kicker { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-display); text-transform: uppercase; letter-spacing: 8dp; color: var(--c-accent); }
.ep-sub { font-size: var(--fs-md); color: var(--c-text-dim); letter-spacing: 1dp; }
.ep-text { display: block; max-width: 640dp; margin: 0 auto var(--sp-6); text-align: center; font-size: var(--fs-md); line-height: 1.5; color: var(--c-text); }

.ep-stats { display: flex; gap: var(--sp-4); margin-bottom: var(--sp-5); }
.ep-stat {
	display: flex; flex: 1 1 0; min-width: 0; flex-direction: column; align-items: center; gap: var(--sp-1);
	padding: var(--sp-4) var(--sp-3);
	background-color: var(--c-panel); border: var(--border) var(--c-line);
}
.ep-num { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-3xl); color: var(--c-text-strong); }
.ep-stat .ep-label, .ep-row-head, .ep-effort .ep-label {
	font-family: var(--font-display); font-weight: 600; font-size: var(--fs-2xs);
	text-transform: uppercase; letter-spacing: 2dp; color: var(--c-text-faint);
}
.ep-stat .ep-sub { font-family: var(--font-mono); font-size: var(--fs-2xs); color: var(--c-text-dim); }

.ep-effort { display: flex; align-items: center; gap: var(--sp-3); width: 100%; margin: 0 auto var(--sp-6); }
.ep-effort .bar { flex: 1 1 0; }
.ep-pct { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-text); }

.ep-row { margin-bottom: var(--sp-4); }
.ep-row-head { margin-bottom: var(--sp-2); }
.ep-chips { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
.ep-chip {
	display: flex; align-items: center; gap: var(--sp-2);
	padding: var(--sp-2) var(--sp-3); background-color: var(--c-panel);
	border: var(--border) var(--c-line);
}
.ep-face { display: block; width: 40dp; height: 40dp; overflow: hidden; background-color: var(--c-inset); border: var(--border) var(--c-inset-line); }
.ep-face img { width: 100%; height: 100%; }
.ep-name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-sm); text-transform: uppercase; color: var(--c-text-strong); }
.ep-badge {
	font-family: var(--font-display); font-size: var(--fs-2xs); text-transform: uppercase; letter-spacing: 1dp;
	color: var(--c-danger); background-color: var(--c-danger-soft); padding: 1dp var(--sp-2);
}
.ep-badge .icon { width: 12dp; height: 12dp; image-color: var(--c-danger); }
.ep-chip .tooltip { top: -64dp; left: 0; }
.ep-chip.dead { background-color: var(--c-bg); border-color: var(--c-line); }
.ep-chip.dead .ep-face img { image-color: #4E4234; }
.ep-chip.dead .ep-name { color: var(--c-text-dim); }

.ep-actions { display: flex; justify-content: center; gap: var(--sp-4); margin-top: var(--sp-6); }
