<rml>
<head>
	<title>Tactical placement (native tactical wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="../../screens/tactical.rcss"/>
	<link type="text/rcss" href="mocks.rcss"/>
</head>
<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<div class="ovh-scrim"></div>
	<div class="ovh-map hud">
		<div class="hud-head"><img class="icon sm" src="icon-destination"/><span class="t" style="margin-left: 8dp;">Placement · A9 Omerta</span><span class="m">arriving from the north · place each merc in the lit zone</span></div>
		<div class="well">
			<!-- stand-in picture: the legacy overhead (640 x 320) at 2x; the native one records the whole sector -->
			<img class="snap" src="overhead-snap" data-x="2" style="margin-left: -640dp; margin-top: -320dp;"/>
			<div class="mapbox">
			<div class="zone" style="left: 0; top: 0; width: 1280dp; height: 96dp;"></div>
			<div class="mk us" style="left: 520dp; top: 40dp;"></div><div class="mk us" style="left: 560dp; top: 56dp;"></div>
			<span class="hov" style="left: 640dp; top: 30dp;">Grizzly · click to place</span>
			</div>
		</div>
	</div>
	<div class="ovh-side hud">
		<div class="hud-head"><span class="t">Arrival</span><div class="grow"></div><span class="m">2 of 4 placed</span></div>
		<div class="prog"><div class="fill" style="width: 50%;"></div></div>
		<div class="who"><div class="face"><img class="pic" src="sface-7"/></div><span class="nm">Ivan</span><span class="ok">placed</span></div><div class="who"><div class="face"><img class="pic" src="sface-0"/></div><span class="nm">Barry</span><span class="ok">placed</span></div><div class="who sel"><div class="face"><img class="pic" src="sface-3"/></div><span class="nm">Grizzly</span><span class="wait">click the zone</span></div><div class="who"><div class="face"><img class="pic" src="sface-17"/></div><span class="nm">Buns</span><span class="wait">waiting</span></div>
		<div class="btns">
			<button class="btn"><img class="icon" src="icon-remove"/><span class="label">Clear</span><span class="kbd">C</span></button>
			<button class="btn"><img class="icon" src="icon-squad"/><span class="label">Spread</span><span class="kbd">S</span></button>
			<button class="btn"><img class="icon" src="icon-player-group"/><span class="label">Group</span><span class="kbd">G</span></button>
			<button class="btn btn-primary is-disabled" title="Place everyone first"><span class="label">Done</span><span class="kbd">Enter</span></button>
		</div>
		<div class="keys">
			<div class="ln"><span class="kbd">Click</span><span>a merc, then the zone · drag a placed merc to move him</span></div>
		</div>
	</div>
</div>
</body>
</rml>
