<rml>
<head>
	<title>Overhead map (native tactical wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="../../screens/tactical.rcss"/>
	<link type="text/rcss" href="mocks.rcss"/>
</head>
<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<div class="ovh-scrim"></div>
	<div class="ovh-map hud">
		<div class="hud-head"><img class="icon sm" src="icon-map"/><span class="t" style="margin-left: 8dp;">Overhead · A9 Omerta</span><span class="m">the whole sector · the box is the view</span></div>
		<div class="well">
			<!-- stand-in picture: the legacy overhead (640 x 320) at 2x; the native one records the whole sector -->
			<img class="snap" src="overhead-snap" data-x="2" style="margin-left: -640dp; margin-top: -320dp;"/>
			<div class="mapbox">
			<div class="mk us sel" style="left: 920dp; top: 136dp;"></div><div class="mk us" style="left: 940dp; top: 146dp;"></div><div class="mk us" style="left: 904dp; top: 152dp;"></div><div class="mk us" style="left: 930dp; top: 160dp;"></div>
			<div class="mk civ" style="left: 390dp; top: 74dp;"></div><div class="mk civ" style="left: 690dp; top: 354dp;"></div><div class="mk civ" style="left: 1050dp; top: 434dp;"></div>
			<div class="mk item" style="left: 550dp; top: 214dp;"></div><div class="mk item" style="left: 810dp; top: 284dp;"></div><div class="mk item" style="left: 290dp; top: 394dp;"></div>
			<div class="view" style="left: 750dp; top: 54dp; width: 360dp; height: 200dp;"></div>
			<span class="hov" style="left: 944dp; top: 104dp;">Ivan</span>
			</div>
		</div>
	</div>
	<div class="ovh-side hud">
		<div class="hud-head"><span class="t">Sector</span><div class="grow"></div><span class="m">Day 1 · 07:00</span></div>
		<span class="sec cap">Legend</span>
		<div class="legend">
			<div class="lg"><span class="sw" style="background-color: #D9A54A;"></span><span class="a">Mercs</span><span class="n">4</span></div>
			<div class="lg"><span class="sw" style="background-color: #B0442E;"></span><span class="a">Enemies seen</span><span class="n">0</span></div>
			<div class="lg"><span class="sw" style="background-color: #A8916B;"></span><span class="a">Civilians</span><span class="n">3</span></div>
			<div class="lg"><span class="sw" style="background-color: #4F86A8; border-radius: 0;"></span><span class="a">Item piles</span><span class="n">3</span></div>
		</div>
		<span class="sec cap">Squad 1</span>
		<div class="who sel"><div class="face"><img class="pic" src="sface-7"/></div><span class="nm">Ivan</span><span class="st">Standing · MP5K 30/30</span></div><div class="who"><div class="face"><img class="pic" src="sface-0"/></div><span class="nm">Barry</span><span class="st">Standing · Glock 6/6</span></div><div class="who"><div class="face"><img class="pic" src="sface-3"/></div><span class="nm">Grizzly</span><span class="st">Standing · 9/9</span></div><div class="who"><div class="face"><img class="pic" src="sface-17"/></div><span class="nm">Buns</span><span class="st">Stealth · 15/15</span></div>
		<div class="keys">
			<div class="ln"><span class="kbd">Click</span><span>centre the view there</span></div>
			<div class="ln"><span class="kbd">Hover</span><span>names · what is in a pile</span></div>
			<div class="ln"><span class="kbd">Insert</span><span class="kbd">Esc</span><span>back to the world</span></div>
		</div>
	</div>
</div>
</body>
</rml>
