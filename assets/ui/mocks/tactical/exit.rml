<rml>
<head>
	<title>Sector exit menu (native tactical wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="../../screens/tactical.rcss"/>
	<link type="text/rcss" href="mocks.rcss"/>
</head>
<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<img class="ptr" src="icon-exit-sector" style="left: 1886dp; top: 500dp; image-color: #D9A54A;"/>
	<div class="mpop hud" id="tac.exit" style="left: 1440dp; top: 330dp; width: 430dp;">
		<div class="hud-head"><img class="icon sm" src="icon-exit-sector"/><span class="t" style="margin-left: 8dp;">Leave A9 → A10</span><span class="m">east edge</span><div class="grow"></div><button class="icon-btn" title="Cancel (Esc)"><img class="icon" src="icon-close"/></button></div>
		<div class="rows">
			<div class="opt on"><div class="rb"></div><span class="a">Squad 1</span><span class="b">4 mercs</span></div>
			<div class="opt"><div class="rb"></div><span class="a">Ivan only</span><span class="b">1 merc</span></div>
			<div class="opt off" title="Everyone in A9 is in squad 1"><div class="rb"></div><span class="a">Everyone in A9</span><span class="b">4 mercs</span></div>
		</div>
		<div class="chk"><div class="bx"></div><span>Load A10 now (otherwise they walk there on the map)</span></div>
		<div class="facts">
			<div class="kv"><span class="k">Travel</span><span class="v">on foot · arrive 07:52</span></div>
			<div class="kv"><span class="k">A10</span><span class="v">rebel hideout · no enemies known</span></div>
			<div class="kv"><span class="k">Left behind</span><span class="v">nobody</span></div>
		</div>
		<div class="foot"><div class="grow"></div><button class="btn"><span class="label">Cancel</span><span class="kbd">Esc</span></button><button class="btn btn-primary"><span class="label">Go</span><span class="kbd">Enter</span></button></div>
	</div>
</div>
</body>
</rml>
