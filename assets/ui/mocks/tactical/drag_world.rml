<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<!-- over the world a held grenade becomes a throw (a drop at the feet on the merc's own tile) -->
	<div class="dot arc" data-anchor="Ivan" data-dx="40" data-dy="23"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="80" data-dy="8"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="120" data-dy="-4"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="160" data-dy="-14"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="200" data-dy="-22"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="240" data-dy="-28"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="280" data-dy="-30"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="320" data-dy="-31"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="360" data-dy="-29"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="400" data-dy="-25"></div>
	<div class="dot arc" data-anchor="Ivan" data-dx="440" data-dy="-19"></div>
	<div class="diamond warn" data-anchor="Ivan" data-dx="480" data-dy="-20"></div>
	<img class="ghost-item" src="nitem-135" data-anchor="Ivan" data-dx="486" data-dy="-58"/>
	<img class="ptr" src="icon-throw" data-anchor="Ivan" data-dx="500" data-dy="-44"/>
	<div class="chip2" data-anchor="Ivan" data-align="left" data-dx="524" data-dy="-70">
		<span class="h">Throw hand grenade</span>
		<div class="l"><span class="k">Range</span><span class="v">7 tiles</span></div>
		<div class="l"><span class="k">AP</span><span class="v ok">5 · 14 left</span></div>
		<div class="l"><span class="k">Lands</span><span class="v warn">± 1 tile</span></div>
		<span class="hint">Click on Ivan: drop at his feet · RMB: put back</span>
	</div>
</div>
</body>
</rml>
