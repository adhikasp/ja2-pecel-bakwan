<rml>
<head>
	<title>World overlays (native tactical wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="../../screens/tactical.rcss"/>
	<link type="text/rcss" href="mocks.rcss"/>
</head>
<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<div class="ring" data-anchor="Barry" data-dy="-6" style="width: 76dp; height: 76dp;"></div>
	<div class="ring thin" data-anchor="Barry" data-dy="-20" style="width: 104dp; height: 104dp;"></div>
	<span class="callout" data-anchor="Barry" data-align="left" data-dx="64" data-dy="10">merc locator (/)</span>
	<div class="band" data-anchor="Ivan" data-dx="-30" data-dy="-36" style="width: 250dp; height: 160dp;"></div>
	<span class="callout" data-anchor="Ivan" data-dx="-30" data-dy="130">rubber-band selection</span>
	<div class="diamond" data-anchor="Ivan" data-dx="300" data-dy="150"></div>
	<div class="pool" data-anchor="Ivan" data-align="left" data-dx="330" data-dy="130">
		<div class="r"><div class="pc"><img class="pic" src="nitem-201" data-x="1"/></div><span class="a">First aid kit</span><span class="q">1</span></div>
		<div class="r"><div class="pc"><img class="pic" src="nitem-71" data-x="1"/></div><span class="a">9 mm magazine</span><span class="q">2</span></div>
		<div class="r"><div class="pc"><img class="pic" src="nitem-64" data-x="1"/></div><span class="a">Crowbar</span><span class="q">1</span></div>
		<span class="more">+2 more · click: the pick-up menu</span>
	</div>
	<span class="callout" data-anchor="Ivan" data-align="left" data-dx="330" data-dy="286">items under the cursor</span>
	<div class="flash" data-anchor="Ivan" data-dx="120" data-dy="300"><img class="icon" src="icon-sector-inventory"/></div>
	<span class="callout" data-anchor="Ivan" data-dx="120" data-dy="344">new item seen (pulses)</span>
	<span class="burst-x" data-anchor="Ivan" data-dx="760" data-dy="40">×</span><span class="burst-x" data-anchor="Ivan" data-dx="796" data-dy="58">×</span><span class="burst-x" data-anchor="Ivan" data-dx="776" data-dy="84">×</span>
	<span class="callout" data-anchor="Ivan" data-dx="780" data-dy="124">burst impacts</span>
	<div class="paused hud"><img class="icon" src="icon-pause"/><span class="t">Game paused</span><span class="kbd">Pause</span></div>
</div>
</body>
</rml>
