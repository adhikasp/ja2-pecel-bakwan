<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<!-- the path through the tile centres: solid for what this turn's AP buys, amber beyond -->
	<div class="dot" data-anchor="Ivan" data-dx="0" data-dy="64"></div>
	<div class="dot" data-anchor="Ivan" data-dx="40" data-dy="84"></div>
	<div class="dot" data-anchor="Ivan" data-dx="80" data-dy="104"></div>
	<div class="dot" data-anchor="Ivan" data-dx="120" data-dy="124"></div>
	<div class="dot" data-anchor="Ivan" data-dx="160" data-dy="144"></div>
	<div class="dot" data-anchor="Ivan" data-dx="200" data-dy="144"></div>
	<div class="dot" data-anchor="Ivan" data-dx="240" data-dy="144"></div>
	<div class="dot far" data-anchor="Ivan" data-dx="280" data-dy="164"></div>
	<div class="dot far" data-anchor="Ivan" data-dx="320" data-dy="184"></div>
	<div class="diamond" data-anchor="Ivan" data-dx="240" data-dy="134"></div>
	<div class="diamond warn" data-anchor="Ivan" data-dx="360" data-dy="194"></div>
	<img class="ptr" src="icon-run" data-anchor="Ivan" data-dx="372" data-dy="168"/>
	<div class="chip2 warn" data-anchor="Ivan" data-align="left" data-dx="392" data-dy="160">
		<span class="h">Run to here</span>
		<div class="l"><span class="k">AP</span><span class="v warn">22 · 14 now, 8 next turn</span></div>
		<div class="l"><span class="k">Noise</span><span class="v">loud (running)</span></div>
		<span class="hint">solid: this turn · amber: next turn · click again: go</span>
	</div>
</div>
</body>
</rml>
