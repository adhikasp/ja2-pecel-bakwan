<rml>
<head>
	<title>NPC talk panel (native tactical wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="../../screens/tactical.rcss"/>
	<link type="text/rcss" href="mocks.rcss"/>
</head>
<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<!-- the approved Phase 5 layout (centred over the bar, never over the speaker), in the Field Kit style -->
	<div class="talk hud" id="tac.talk">
		<div class="body">
			<div class="npc"><div class="face"><img class="pic" src="sface-63"/><img class="spk" src="icon-talk"/></div><span class="nm">Fatima</span><span class="rl">Omerta rebel · profile</span></div>
			<div class="say" id="tac.talk.text">
				<span class="who">Fatima</span>
				<span class="line">"You are the ones Enrico sent? Then take this letter to the rebels. They are hiding near here, and they will not trust you without it."</span>
				<span class="prev">Ivan (friendly): "We are here to help your people, miss."</span>
			</div>
		</div>
		<div class="opts" id="tac.talk.approaches">
			<button class="btn on" title="Friendly approach"><img class="icon" src="icon-ok"/><span class="label">Friendly</span><span class="kbd">1</span></button>
			<button class="btn" title="Direct approach"><img class="icon" src="icon-chevron-right"/><span class="label">Direct</span><span class="kbd">2</span></button>
			<button class="btn" title="Threaten"><img class="icon" src="icon-warning"/><span class="label">Threaten</span><span class="kbd">3</span></button>
			<button class="btn" title="Give: drag an item or money onto the face"><img class="icon" src="icon-trade"/><span class="label">Give</span><span class="kbd">4</span></button>
			<button class="btn is-disabled" title="She will not join"><img class="icon" src="icon-add"/><span class="label">Recruit</span><span class="kbd">5</span></button>
			<button class="btn" title="Ask to repeat"><img class="icon" src="icon-reload"/><span class="label">Come again?</span><span class="kbd">6</span></button>
			<div class="grow"></div>
			<button class="btn btn-primary" title="Stop talking"><span class="label">Done</span><span class="kbd">Esc</span></button>
		</div>
	</div>
	<div class="bubble" data-anchor="Ivan" data-dy="-96"><span class="who">Ivan</span><span class="tx">"Comrade, we will deliver your letter."</span></div>
</div>
</body>
</rml>
