<!-- Wireframe for docs/plan/native-tactical.md, drawn over the live tactical HUD in the real game
     (tests/e2e/manual/native_tactical_mocks.lua). Literal data. Generated by tools/ui/native_tactical_mocks.py:
     edit the generator, not this file. -->
<body class="t5 mock">
<div class="t5-root">
	<div class="tgt hot" style="left: 650dp; top: 521dp; width: 52dp; height: 52dp;"></div>
	<div class="mpop hud" id="tac.stack" style="left: 640dp; top: 214dp; width: 452dp;">
		<div class="hud-head"><img class="icon sm" src="icon-ammo"/><span class="t" style="margin-left: 8dp;">9 mm magazines</span><span class="m">4 in vest pocket 1</span><div class="grow"></div><button class="icon-btn" title="Close (Esc)"><img class="icon" src="icon-close"/></button></div>
		<div class="stk"><div class="it"><div class="pc"><img class="pic" src="nitem-71"/></div><span class="v">15/15</span></div><div class="it"><div class="pc"><img class="pic" src="nitem-71"/></div><span class="v">15/15</span></div><div class="it on"><div class="pc"><img class="pic" src="nitem-71"/></div><span class="v low">9/15</span></div><div class="it"><div class="pc"><img class="pic" src="nitem-71"/></div><span class="v">15/15</span></div></div>
		<div class="split"><span class="k">Take</span><button class="icon-btn"><img class="icon sm" src="icon-remove"/></button><span class="n">2</span><button class="icon-btn"><img class="icon sm" src="icon-add"/></button><div class="grow"></div></div>
		<div class="foot"><button class="btn"><span class="label">Take one</span></button><button class="btn"><span class="label">Take 2</span></button><div class="grow"></div><button class="btn btn-primary"><span class="label">Take all</span></button></div>
		<span class="hint">Click a magazine to take that one · drag one onto a slot, a card or a gun to load it</span>
	</div>
</div>
</body>
</rml>
