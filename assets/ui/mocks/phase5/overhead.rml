<rml>
<head>
	<title>Tactical: overhead map (Phase 5 wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="tactical.rcss"/>
</head>
<!-- M2 wireframe of the native tactical HUD (docs/ui/tactical.md), shown over the real tactical world.
     Literal data. Generated by tools/ui/phase5_mocks.py: edit the generator, not this file. -->
<body class="t5">
<div class="t5-root" id="tac">
<div class="ovh-bg"></div><div class="ovh-map hud" id="tac.overhead.map"><img src="overhead-snap"/></div>
	<div class="ovh-side l hud" id="tac.overhead.info">
		<div class="sect"><span class="cap">Overhead map</span><span class="big">A9 &#183; Omerta</span><span class="sm">Day 1, 08:16 &#183; town, 3 buildings searched</span></div>
		<div class="sect"><span class="cap">Legend</span>
			<div class="lg"><div class="dot us sel"></div><span>Selected merc</span></div>
			<div class="lg"><div class="dot us"></div><span>Our mercs</span><span class="n">4</span></div>
			<div class="lg"><div class="dot foe"></div><span>Enemies seen</span><span class="n">2</span></div>
			<div class="lg"><div class="dot mil"></div><span>Militia</span><span class="n">0</span></div>
			<div class="lg"><div class="dot civ"></div><span>Civilians</span><span class="n">5</span></div>
			<div class="lg"><div class="sw" style="background-color: #F2B33D;"></div><span>Items on the ground</span><span class="n">7</span></div>
		</div>
		<div class="sect"><span class="cap">Squad 1</span>
			<div class="row sel" id="tac.overhead.merc[ivan]"><div class="face"><img class="pic" src="sface-7" data-x="1"/></div><span class="nm">Ivan</span></div><div class="row" id="tac.overhead.merc[barry]"><div class="face"><img class="pic" src="sface-0" data-x="1"/></div><span class="nm">Barry</span></div><div class="row" id="tac.overhead.merc[grizzly]"><div class="face"><img class="pic" src="sface-3" data-x="1"/></div><span class="nm">Grizzly</span></div><div class="row" id="tac.overhead.merc[buns]"><div class="face"><img class="pic" src="sface-17" data-x="1"/></div><span class="nm">Buns</span></div>
		</div>
		<div class="foot"><button class="btn btn-primary" id="tac.overhead.close"><img class="icon" src="icon-close"/><span class="label">Back to the world</span><span class="kbd">Ins</span></button>
			<span class="sm">Click: centre the world there &#183; right-click: back</span></div>
	</div>
	<div class="ovh-tip audit-skip" style="left: 980dp; top: 520dp;">Grizzly &#183; standing &#183; HP 95</div>
</div>
</body>
</rml>
