<rml>
<head>
	<title>Tactical: action, door and pick-up menus (Phase 5 wireframe)</title>
	<link type="text/rcss" href="../../components.rcss"/>
	<link type="text/rcss" href="tactical.rcss"/>
</head>
<!-- M2 wireframe of the native tactical HUD (docs/ui/tactical.md), shown over the real tactical world.
     Literal data. Generated by tools/ui/phase5_mocks.py: edit the generator, not this file. -->
<body class="t5" data-world="clear">
<div class="t5-root" id="tac">
<div class="ov ov-merc sel audit-skip" data-anchor="Ivan" data-dy="-6"><span class="nm">Ivan</span><div class="bars"><div class="bar hp"><div class="fill" style="width: 93%"></div></div><div class="bar breath"><div class="fill" style="width: 70%"></div></div></div></div>
	<div class="ov ov-merc audit-skip" data-anchor="Barry" data-dy="-6"><span class="nm">Barry</span><div class="bars"><div class="bar hp"><div class="fill" style="width: 77%"></div></div><div class="bar breath"><div class="fill" style="width: 48%"></div></div></div></div>
	<div class="ov ov-merc audit-skip" data-anchor="Grizzly" data-dy="-6"><span class="nm">Grizzly</span><div class="bars"><div class="bar hp"><div class="fill" style="width: 100%"></div></div><div class="bar breath"><div class="fill" style="width: 77%"></div></div></div></div>
	<div class="ov ov-merc audit-skip" data-anchor="Buns" data-dy="-6"><span class="nm">Buns</span><div class="bars"><div class="bar hp"><div class="fill" style="width: 92%"></div></div><div class="bar breath"><div class="fill" style="width: 81%"></div></div></div></div>
	<div class="log-lines audit-skip" id="tac.log.lines" title="Recent messages (L opens the log)"><div class="log-line dialogue old"><span class="tm">08:14</span><span class="tx">Ivan: "Area looks clear, comrades."</span></div><div class="log-line "><span class="tm">08:15</span><span class="tx">Barry has picked up a first aid kit.</span></div><div class="log-line combat"><span class="tm">08:16</span><span class="tx">Grizzly is bleeding.</span></div></div>
	<div class="mini hud" id="tac.minimap">
		<div class="where"><span class="sec">A9</span><span class="town">Omerta</span><div class="grow"></div><span class="day">DAY 1</span><span class="clock">08:16</span></div>
		<div class="radar" id="tac.minimap.map" title="Click to look there; drag to pan"><div class="bld" style="left: 18dp; top: 20dp; width: 60dp; height: 40dp;"></div><div class="bld" style="left: 96dp; top: 14dp; width: 40dp; height: 52dp;"></div><div class="bld" style="left: 170dp; top: 34dp; width: 70dp; height: 30dp;"></div><div class="bld" style="left: 40dp; top: 96dp; width: 54dp; height: 44dp;"></div><div class="bld" style="left: 130dp; top: 104dp; width: 46dp; height: 40dp;"></div><div class="bld" style="left: 210dp; top: 92dp; width: 60dp; height: 52dp;"></div><div class="road" style="left: 0dp; top: 76dp; width: 300dp; height: 10dp;"></div><div class="road" style="left: 150dp; top: 0dp; width: 10dp; height: 176dp;"></div><div class="view" style="left: 96dp; top: 70dp; width: 120dp; height: 76dp;"></div><div class="dot us sel" style="left: 150dp; top: 120dp;"></div><div class="dot us" style="left: 162dp; top: 128dp;"></div><div class="dot us" style="left: 140dp; top: 132dp;"></div><div class="dot us" style="left: 170dp; top: 116dp;"></div><div class="dot civ" style="left: 60dp; top: 60dp;"></div><div class="dot mil" style="left: 230dp; top: 70dp;"></div></div>
		<div class="mtools">
			<button class="icon-btn" id="tac.overhead" title="Overhead map (Insert)"><img class="icon" src="icon-map"/></button>
			<button class="icon-btn" id="tac.roofs" title="Show roofs and tree tops (T)"><img class="icon" src="icon-unexplored"/></button>
			<button class="icon-btn" id="tac.glow" title="Highlight items on the ground (I)"><img class="icon" src="icon-sector-inventory"/></button>
			<div class="legend"><div class="dot us"></div><span>Us</span><div class="dot foe"></div><span>Enemy</span><div class="dot mil"></div><span>Militia</span></div>
		</div>
	</div>
	<div class="sbar" id="tac.bar">
		<div class="squads" id="tac.squadtabs"><div class="sq on" id="tac.squadtab[1]" title="Squad 1 (1)"><span>1</span><span class="n">4</span></div><div class="sq" id="tac.squadtab[2]" title="Squad 2 (2)"><span>2</span><span class="n">2</span></div><div class="sq empty" id="tac.squadtab[3]" title="Squad 3 (3)"><span>3</span></div><div class="sq" id="tac.squadtab.next" title="Next squad (Shift+Space)"><img class="icon sm" src="icon-chevron-down"/></div></div>
		<div class="cards" id="tac.squad"><div class="tcard sel" id="tac.squad[ivan]" title="Ivan: click to select, double-click for details (`)">
			<div class="face"><img class="pic" src="sface-7"/></div>
			<div class="info">
				<div class="nr"><span class="nm">Ivan</span></div>
				<span class="sub">Standing</span>
				<div class="st"><span class="k">HP</span><div class="bar hp"><div class="fill" style="width: 82%"></div><div class="lost" style="width: 6%"></div></div><span class="v">82</span></div>
				<div class="st"><span class="k">EN</span><div class="bar breath"><div class="fill" style="width: 70%"></div></div><span class="v">70</span></div>
				<div class="st"><span class="k">MO</span><div class="bar morale"><div class="fill" style="width: 66%"></div></div><span class="v">66</span></div>
				<div class="hand" id="tac.squad[ivan].hand" title="In hand: right-click for details"><img class="pic" src="nitem-26" data-x="1"/><span class="am">24/30</span></div>
			</div>
		</div><div class="tcard" id="tac.squad[barry]" title="Barry: click to select, double-click for details (`)">
			<div class="face"><img class="pic" src="sface-0"/></div>
			<div class="info">
				<div class="nr"><span class="nm">Barry</span><img class="icon danger" src="icon-bleeding" title="Bleeding"/></div>
				<span class="sub">Crouched</span>
				<div class="st"><span class="k">HP</span><div class="bar hp"><div class="fill" style="width: 61%"></div><div class="lost" style="width: 18%"></div></div><span class="v">61</span></div>
				<div class="st"><span class="k">EN</span><div class="bar breath"><div class="fill" style="width: 48%"></div></div><span class="v">48</span></div>
				<div class="st"><span class="k">MO</span><div class="bar morale"><div class="fill" style="width: 58%"></div></div><span class="v">58</span></div>
				<div class="hand" id="tac.squad[barry].hand" title="In hand: right-click for details"><img class="pic" src="nitem-8" data-x="1"/><span class="am">5/7</span></div>
			</div>
		</div><div class="tcard" id="tac.squad[grizzly]" title="Grizzly: click to select, double-click for details (`)">
			<div class="face"><img class="pic" src="sface-3"/></div>
			<div class="info">
				<div class="nr"><span class="nm">Grizzly</span></div>
				<span class="sub">Standing</span>
				<div class="st"><span class="k">HP</span><div class="bar hp"><div class="fill" style="width: 95%"></div><div class="lost" style="width: 0%"></div></div><span class="v">95</span></div>
				<div class="st"><span class="k">EN</span><div class="bar breath"><div class="fill" style="width: 77%"></div></div><span class="v">77</span></div>
				<div class="st"><span class="k">MO</span><div class="bar morale"><div class="fill" style="width: 72%"></div></div><span class="v">72</span></div>
				<div class="hand" id="tac.squad[grizzly].hand" title="In hand: right-click for details"><img class="pic" src="nitem-31" data-x="1"/><span class="am low">2/7</span></div>
			</div>
		</div><div class="tcard" id="tac.squad[buns]" title="Buns: click to select, double-click for details (`)">
			<div class="face"><img class="pic" src="sface-17"/></div>
			<div class="info">
				<div class="nr"><span class="nm">Buns</span><img class="icon info" src="icon-sneak" title="Sneak"/></div>
				<span class="sub">Stealth</span>
				<div class="st"><span class="k">HP</span><div class="bar hp"><div class="fill" style="width: 66%"></div><div class="lost" style="width: 5%"></div></div><span class="v">66</span></div>
				<div class="st"><span class="k">EN</span><div class="bar breath"><div class="fill" style="width: 81%"></div></div><span class="v">81</span></div>
				<div class="st"><span class="k">MO</span><div class="bar morale"><div class="fill" style="width: 52%"></div></div><span class="v">52</span></div>
				<div class="hand" id="tac.squad[buns].hand" title="In hand: right-click for details"><img class="pic" src="nitem-3" data-x="1"/><span class="am low">4/15</span></div>
			</div>
		</div><div class="tcard ghost"><span>Empty slot</span></div><div class="tcard ghost"><span>Empty slot</span></div></div>
		<div class="tools" id="tac.tools">
			<div class="row"><button class="icon-btn on" id="tac.stance.stand" title="Stand (S)"><img class="icon" src="icon-stance-stand"/><span class="kk">S</span></button><button class="icon-btn" id="tac.stance.crouch" title="Crouch (C)"><img class="icon" src="icon-stance-crouch"/><span class="kk">C</span></button><button class="icon-btn" id="tac.stance.prone" title="Prone (P)"><img class="icon" src="icon-stance-prone"/><span class="kk">P</span></button><div class="sep"></div><button class="icon-btn" id="tac.move.run" title="Run (R)"><img class="icon" src="icon-run"/><span class="kk">R</span></button><button class="icon-btn" id="tac.stealth" title="Stealth mode (Z)"><img class="icon" src="icon-sneak"/><span class="kk">Z</span></button></div>
			<div class="row"><button class="icon-btn" id="tac.burst" title="Burst fire (B)"><img class="icon" src="icon-burst"/><span class="kk">B</span></button><button class="icon-btn" id="tac.look" title="Look / turn (L)"><img class="icon" src="icon-look"/><span class="kk">L</span></button><button class="icon-btn" id="tac.talk" title="Talk (T)"><img class="icon" src="icon-talk"/><span class="kk">T</span></button><div class="sep"></div><button class="icon-btn" id="tac.climb" title="Climb (J)"><img class="icon" src="icon-climb"/><span class="kk">J</span></button><button class="icon-btn" id="tac.level" title="View roof level (Tab)"><img class="icon" src="icon-chevron-up"/><span class="kk">Tab</span></button></div>
		</div>
		<div class="sys" id="tac.sys">
			<button class="btn is-disabled" id="tac.endturn" title="Start turn-based combat (D)"><img class="icon" src="icon-end-turn"/><span class="label">Turn-based</span><span class="kbd">D</span></button>
			<button class="btn" id="tac.map" title="Strategic map (M)"><img class="icon" src="icon-map"/><span class="label">Map</span><span class="kbd">M</span></button>
			<div class="row"><button class="icon-btn" id="tac.inventory" title="Merc details and inventory (`)"><img class="icon" src="icon-inventory"/></button><button class="icon-btn" id="tac.log" title="Message log (L)"><img class="icon" src="icon-menu"/></button><button class="icon-btn last" id="tac.options" title="Options (O), save (Ctrl+S), load (Ctrl+L)"><img class="icon" src="icon-options"/></button></div>
		</div>
	</div>
	<div class="pop menu audit-skip" id="tac.actionmenu" data-anchor="Ivan" data-dx="70" data-dy="0" data-align="left">
		<div class="menu-title"><span class="t">Ivan</span><span class="m">14 AP</span></div>
		<div class="menu-head">Move</div>
		<div class="menu-item"><img class="icon" src="icon-walk"/><span class="label">Walk</span><span class="kbd">S</span></div><div class="menu-item"><img class="icon" src="icon-run"/><span class="label">Run</span><span class="kbd">R</span></div><div class="menu-item"><img class="icon" src="icon-sneak"/><span class="label">Crouched move</span><span class="kbd">C</span></div><div class="menu-item"><img class="icon" src="icon-stance-prone"/><span class="label">Crawl</span><span class="kbd">P</span></div>
		<div class="menu-sep"></div>
		<div class="menu-head">Act</div>
		<div class="menu-item"><img class="icon" src="icon-gun"/><span class="label">Use firearm</span><span class="ap">5 AP</span></div><div class="menu-item"><img class="icon" src="icon-look"/><span class="label">Look</span><span class="kbd">L</span></div><div class="menu-item"><img class="icon" src="icon-talk"/><span class="label">Talk</span><span class="kbd">T</span></div><div class="menu-item"><img class="icon" src="icon-pointer"/><span class="label">Examine / handle</span><span class="kbd">Ctrl</span></div>
		<div class="menu-sep"></div>
		<div class="menu-item"><img class="icon" src="icon-close"/><span class="label">Cancel</span><span class="kbd">Esc</span></div>
	</div>
	<div class="pop menu audit-skip" id="tac.doormenu" style="left: 1240dp; top: 330dp;">
		<div class="menu-title"><span class="t">Door</span><span class="m">Barry &#183; 16 AP</span></div>
		<div class="menu-item"><img class="icon" src="icon-door"/><span class="label">Open</span><span class="ap">3 AP</span></div>
		<div class="menu-item"><img class="icon" src="icon-search"/><span class="label">Examine for traps</span><span class="ap">5 AP</span></div>
		<div class="menu-item is-disabled"><img class="icon" src="icon-wire-cut"/><span class="label">Untrap</span><span class="ap">10 AP</span></div><span class="why">No trap found yet</span>
		<div class="menu-sep"></div>
		<div class="menu-item is-disabled"><img class="icon" src="icon-key"/><span class="label">Unlock with key</span><span class="ap">5 AP</span></div><span class="why">No key for this door</span>
		<div class="menu-item is-disabled"><img class="icon" src="icon-toolkit"/><span class="label">Pick the lock</span><span class="ap">8 AP</span></div><span class="why">Needs a lockpick kit</span>
		<div class="menu-item"><img class="icon" src="icon-stab"/><span class="label">Use crowbar</span><span class="ap">10 AP</span></div>
		<div class="menu-item"><img class="icon" src="icon-punch"/><span class="label">Force open</span><span class="ap">10 AP</span></div>
		<div class="menu-item is-disabled"><img class="icon" src="icon-bomb"/><span class="label">Use explosive</span><span class="ap">10 AP</span></div><span class="why">No shaped charge</span>
		<div class="menu-sep"></div>
		<div class="menu-item"><img class="icon" src="icon-close"/><span class="label">Cancel</span><span class="kbd">Esc</span></div>
	</div>
	<div class="pop pick hud audit-skip" id="tac.pickup" style="left: 760dp; top: 470dp;">
		<div class="hud-head"><img class="icon sm" src="icon-sector-inventory"/><span class="t" style="margin-left: 8dp;">Pick up</span><span class="m">Buns &#183; 4 items here</span></div>
		<div class="row on" id="tac.pickup[0]"><div class="chk on"><img class="icon" src="icon-confirm"/></div><div class="pbox"><img class="pic" src="nitem-26"/></div><span class="n">AKM</span><span class="q"></span></div><div class="row on" id="tac.pickup[1]"><div class="chk on"><img class="icon" src="icon-confirm"/></div><div class="pbox"><img class="pic" src="nitem-97"/></div><span class="n">7.62 mm WP clip</span><span class="q">&#215;2</span></div><div class="row" id="tac.pickup[2]"><div class="chk"></div><div class="pbox"><img class="pic" src="nitem-201"/></div><span class="n">First aid kit</span><span class="q"></span></div><div class="row on" id="tac.pickup[3]"><div class="chk on"><img class="icon" src="icon-confirm"/></div><div class="pbox"><img class="pic" src="nitem-219"/></div><span class="n">Money</span><span class="q">$140</span></div>
		<div class="pick-foot foot"><button class="btn" id="tac.pickup.all"><span class="label">All</span><span class="kbd">A</span></button><div class="grow"></div><button class="btn" id="tac.pickup.cancel"><span class="label">Cancel</span></button><button class="btn btn-primary" id="tac.pickup.ok"><span class="label">Take 3</span><span class="kbd">Enter</span></button></div>
	</div>
</div>
</body>
</rml>
