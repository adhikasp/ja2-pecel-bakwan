/* The native shopkeeper / arms-dealer trade screen (docs/ui/shopkeeper.md). Components and tokens come from
 * ../components.rcss and ../tokens.rcss; nothing here hard-codes a colour. The arrangement follows the legacy
 * trade screen: the dealer face, page control, totals and buttons in the left column; the stock and the two offer
 * areas stacked in the main column; the merc's inventory as the bottom strip (the legacy inventory panel). */

.sk-root {
	display: flex; align-items: stretch; justify-content: center;
	position: absolute; left: 0; top: 0; right: 0; bottom: 0;
	background-color: var(--c-void);
}
body.sk { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--c-void); }

.sk-frame {
	display: flex; flex-direction: column;
	width: 98%; height: 96%; margin: auto;
	padding: var(--sp-3); box-sizing: border-box;
	background-color: var(--e1-bg); decorator: image(gen-mottle repeat);
	border: var(--border) var(--e1-line); border-color: var(--c-bevel-hi) var(--c-bevel-lo) var(--c-bevel-lo) var(--c-bevel-hi);
	border-radius: var(--r-2);
}

/* ---------------------------------------------------------------- the trade screen */
.sk-trade { display: flex; flex: 1 1 auto; min-height: 0; padding-bottom: var(--sp-3); border-bottom: var(--border) var(--c-line); }

/* ---- left column: dealer, page, totals, actions ---- */
.sk-side { display: flex; flex-direction: column; flex: 0 0 240dp; padding-right: var(--sp-3); border-right: var(--border) var(--c-line); }
.sk-dealer { display: flex; align-items: flex-start; }
.sk-face { width: 72dp; height: 82dp; margin-right: var(--sp-3); border: var(--border) var(--c-line-2); background-color: var(--c-inset); }
.sk-face.sm { width: 40dp; height: 46dp; margin: 0 var(--sp-2) 0 0; }
.sk-who { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; }
.sk-who .t { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); text-transform: uppercase; color: var(--c-text-strong); }
.sk-who .s { display: block; font-size: var(--fs-sm); color: var(--c-text-dim); }

.sk-pagebar { display: flex; align-items: center; margin-top: var(--sp-2); padding: var(--sp-1) var(--sp-2); background-color: var(--c-panel-2); border: var(--border) var(--c-line); border-radius: var(--r-1); }
.sk-pagebar .k { display: block; font-size: var(--fs-xs); text-transform: uppercase; color: var(--c-text-dim); margin-right: var(--sp-2); }
.sk-pagebar .v { display: block; font-family: var(--font-mono); font-size: var(--fs-md); color: var(--c-text-strong); margin-right: auto; }
.sk-pagebar .icon-btn { width: 28dp; height: 28dp; }

.sk-totals { display: flex; flex-direction: column; flex: 1 1 auto; gap: var(--sp-2); margin-top: var(--sp-3); min-height: 0; }
.sk-box { display: flex; flex-direction: column; padding: var(--sp-2); background-color: var(--c-inset); border: var(--border) var(--c-inset-line); border-radius: var(--r-1); }
.sk-box .k { display: block; font-family: var(--font-display); font-size: var(--fs-xs); text-transform: uppercase; color: var(--c-text-dim); }
.sk-box .v { display: block; font-family: var(--font-mono); font-size: var(--fs-lg); color: var(--c-accent); }

.sk-acts { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-3); }
.sk-acts .btn { width: 100%; }

/* ---- main column: stock, the two offer areas ---- */
.sk-main { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; min-height: 0; padding-left: var(--sp-3); }
.sk-title { display: flex; align-items: baseline; flex: 0 0 auto; margin-top: var(--sp-2); padding-bottom: 2dp; border-bottom: var(--border) var(--c-line); }
.sk-title .t { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); text-transform: uppercase; color: var(--c-text-strong); }
.sk-title .tot { display: block; margin-left: auto; font-size: var(--fs-xs); text-transform: uppercase; color: var(--c-text-dim); }
.sk-title .tot b { display: inline-block; margin-left: var(--sp-1); font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-accent); }

.sk-grid { display: flex; flex-wrap: wrap; align-content: flex-start; gap: var(--sp-2); overflow-y: auto; }
.sk-stockgrid { flex: 0 0 auto; margin: var(--sp-2) 0 var(--sp-3); }
.sk-offergrid { flex: 0 0 auto; max-height: 96dp; margin: var(--sp-2) 0 var(--sp-3); }
.sk-stockgrid .sk-cell { flex: 0 0 18.5%; }
.sk-offergrid .sk-cell { flex: 0 0 15.5%; }

.sk-cell {
	display: flex; flex-direction: column; position: relative;
	padding: var(--sp-1); box-sizing: border-box;
	background-color: var(--c-panel-2); border: var(--border) var(--c-line); border-radius: var(--r-1);
	cursor: pointer; transition: border-color var(--t-fast) var(--ease);
}
.sk-cell:hover { border-color: var(--c-select); background-color: var(--c-panel-3); }
.sk-cell.selected { border-color: var(--c-warn); }
.sk-cell.repaired { border-color: var(--c-ok); }
.sk-cell.is-empty { border-color: var(--c-line); background-color: var(--c-bg); cursor: default; }
.sk-art { display: flex; align-items: center; justify-content: center; height: 30dp; margin-bottom: 1dp; }
.sk-art img { max-width: 100%; max-height: 30dp; }
.sk-name { display: block; font-size: var(--fs-2xs); color: var(--c-text-strong); line-height: 14dp; }
.sk-bar { display: block; position: relative; height: 4dp; margin: 2dp 0; background-color: var(--c-stat-track); overflow: hidden; }
.sk-bar .fill { position: absolute; left: 0; top: 0; bottom: 0; }
.sk-bar .fill.ok { background-color: var(--c-ok); }
.sk-bar .fill.warn { background-color: var(--c-warn); }
.sk-bar .fill.danger { background-color: var(--c-danger); }
.sk-price { display: block; font-size: var(--fs-xs); color: var(--c-accent); }
.sk-qty { display: block; position: absolute; right: var(--sp-1); top: var(--sp-1); font-size: var(--fs-2xs); color: var(--c-text-dim); }
.sk-ov { display: block; font-size: var(--fs-2xs); color: var(--c-warn); }
.sk-empty { display: block; flex: 0 0 auto; font-size: var(--fs-sm); color: var(--c-text-faint); }

/* ---------------------------------------------------------------- your items (the inventory panel) */
.sk-bottom { display: flex; flex: 0 0 auto; max-height: 38%; min-height: 0; padding-top: var(--sp-3); }
.sk-merc { display: flex; align-items: center; flex: 0 0 auto; padding-right: var(--sp-3); border-right: var(--border) var(--c-line); }
.sk-merc .n { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-md); text-transform: uppercase; color: var(--c-text); }
.sk-merc .k { display: block; font-size: var(--fs-xs); text-transform: uppercase; color: var(--c-text-dim); margin-left: var(--sp-3); }

.sk-invgrid { display: flex; flex: 1 1 0; flex-wrap: wrap; align-content: flex-start; gap: var(--sp-1); min-width: 0; overflow-y: auto; padding: 0 var(--sp-3); }
.sk-invgrid .sk-cell { flex: 0 0 15%; }

/* ---------------------------------------------------------------- comparison / detail */
.sk-detail { display: flex; flex: 0 0 34%; min-width: 0; padding-left: var(--sp-3); border-left: var(--border) var(--c-line); overflow: hidden; }
.sk-detail-art { display: flex; align-items: center; justify-content: center; width: 56dp; height: 56dp; margin-right: var(--sp-3); background-color: var(--c-inset); border: var(--border) var(--c-inset-line); }
.sk-detail-art img { max-width: 100%; max-height: 100%; }
.sk-detail-main { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; }
.sk-detail-head { display: flex; align-items: baseline; }
.sk-detail-head .n { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); text-transform: uppercase; color: var(--c-text-strong); margin-right: var(--sp-3); }
.sk-detail-head .c { display: block; font-family: var(--font-mono); font-size: var(--fs-sm); }
.sk-detail-head .c.ok { color: var(--c-ok); }
.sk-detail-head .c.warn { color: var(--c-warn); }
.sk-detail-head .c.danger { color: var(--c-danger); }
.sk-detail-head .ov { display: block; margin-left: var(--sp-3); font-size: var(--fs-xs); color: var(--c-warn); }
.sk-detail-cmp { display: flex; align-items: baseline; margin-top: var(--sp-1); }
.sk-detail-cmp .k { display: block; font-size: var(--fs-xs); text-transform: uppercase; color: var(--c-text-dim); margin-right: var(--sp-1); }
.sk-detail-cmp .v { display: block; font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--c-accent); margin-right: var(--sp-4); }
.sk-help { display: block; margin-top: var(--sp-1); font-size: var(--fs-xs); line-height: 17dp; color: var(--c-text-dim); overflow: hidden; }
