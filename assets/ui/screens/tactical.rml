<rml>
<head>
	<title>Tactical HUD</title>
	<link type="text/rcss" href="../components.rcss"/>
	<link type="text/rcss" href="tactical.rcss"/>
</head>
<!-- The native tactical HUD (docs/ui/tactical.md, src/game/NativeUI/TacticalHud.cc). An overlay over the tactical
     screen: everything with class "hit" takes the mouse, the rest lets it through to the world. -->
<body class="t5">
<div class="t5-root" id="tac" data-model="tactical">

	<!-- names, bars and damage over the mercs (the legacy rules of who gets one) -->
	<div class="ov-layer">
		<div class="ov ov-merc audit-skip" data-for="o : overlays" data-class-sel="o.sel" data-style-left="(o.x - 60) + 'px'" data-style-top="(o.y - 4) + 'px'">
			<span class="act" data-if="o.action != ''" data-class-yellow="o.yellow">{{o.action}}</span>
			<span class="nm" data-if="o.name != ''">{{o.name}}</span>
			<div class="bars" data-if="o.bars"><div class="bar hp"><div class="fill" data-style-width="o.hpw + '%'"></div></div><div class="bar breath"><div class="fill" data-style-width="o.enw + '%'"></div></div></div>
			<span class="health" data-if="o.health != ''">{{o.health}}</span>
			<span class="dmg" data-if="o.dmg != ''">{{o.dmg}}</span>
		</div>
	</div>

	<!-- message lines (top left) -->
	<div class="log-lines audit-skip" id="tac.log.lines" data-if="!log_open">
		<div class="log-line" data-for="l : lines" data-class-combat="l.cls == 'combat'" data-class-dialogue="l.cls == 'dialogue'" data-class-ok="l.cls == 'ok'"><span class="tx">{{l.text}}</span></div>
	</div>

	<!-- message log (H) -->
	<div class="logp hud hit" id="tac.logpanel" data-if="log_open">
		<div class="hud-head"><img class="icon sm" src="icon-menu"/><span class="t" style="margin-left: 8dp;">{{l_log}}</span><span class="m">{{log_all}}</span><div class="grow"></div>
			<button class="icon-btn" id="tac.logpanel.close" title="Close (H)" data-event-click="log"><img class="icon" src="icon-close"/></button></div>
		<div class="filters">
			<div class="chip" id="tac.log.all" data-class-on="log_filter == 'all'" data-event-click="log_filter('all')"><span>All</span><span class="n">{{log_all}}</span></div>
			<div class="chip" id="tac.log.combat" data-class-on="log_filter == 'combat'" data-event-click="log_filter('combat')"><span>Combat</span><span class="n">{{log_combat}}</span></div>
			<div class="chip" id="tac.log.speech" data-class-on="log_filter == 'speech'" data-event-click="log_filter('speech')"><span>Speech</span><span class="n">{{log_speech}}</span></div>
			<div class="chip" id="tac.log.system" data-class-on="log_filter == 'system'" data-event-click="log_filter('system')"><span>System</span><span class="n">{{log_system}}</span></div>
		</div>
		<div class="list scroll" id="tac.log.list">
			<div class="ln" data-for="l : log" data-class-combat="l.cls == 'combat'" data-class-dialogue="l.cls == 'dialogue'" data-class-ok="l.cls == 'ok'"><span class="tx">{{l.text}}</span></div>
		</div>
	</div>

	<!-- turn banner -->
	<div class="banner" id="tac.turn" data-if="banner">
		<div class="pill" data-class-foe="banner_cls == 'foe' || banner_cls == 'int foe'" data-class-int="banner_cls == 'int' || banner_cls == 'int foe'">
			<img class="icon" src="icon-action-points"/><span class="t" id="tac.turn.title">{{banner_title}}</span><span class="m" data-if="banner_text != ''">{{banner_text}}</span>
			<div class="prog" data-if="banner_progress"><div class="fill" data-style-width="banner_pct + '%'"></div></div>
		</div>
	</div>

	<!-- sector card (top right) -->
	<div class="mini hud hit" id="tac.minimap">
		<div class="where"><span class="sec" id="tac.sector">{{sector}}</span><span class="town">{{town}}</span><div class="grow"></div><span class="day">{{day}}</span><span class="clock" id="tac.clock">{{clock}}</span></div>
		<div class="mtools">
			<button class="icon-btn" id="tac.overhead" title="Overhead map (Insert)" data-event-click="key('insert')"><img class="icon" src="icon-map"/></button>
			<button class="icon-btn" id="tac.roofs" title="Tree tops (T)" data-event-click="key('t')"><img class="icon" src="icon-unexplored"/></button>
			<button class="icon-btn" id="tac.glow" title="Item glow (I)" data-event-click="key('i')"><img class="icon" src="icon-sector-inventory"/></button>
			<button class="icon-btn" id="tac.log" title="Message log (H)" data-event-click="log"><img class="icon" src="icon-menu"/></button>
		</div>
	</div>

	<!-- merc details and inventory (` or a double click on a card) -->
	<div class="detail hud hit" id="tac.detail" data-if="detail">
		<div class="who">
			<div class="face"><img class="pic" data-attr-src="d_face" data-style-width="d_fw + 'px'" data-style-height="d_fh + 'px'"/></div>
			<div class="names"><span class="nm" id="tac.detail.name">{{d_name}}</span><span class="full">{{d_full}}</span><button class="btn" id="tac.detail.loadout" data-attr-data-label="l_loadout" data-event-click="loadout"><img class="icon" src="icon-inventory"/><span class="label">{{l_loadout}}</span></button></div>
			<div class="vit">
				<div class="stat"><span class="k">HP</span><span class="bar hp"><span class="fill" data-style-width="d_hpw + '%'"></span><span class="lost" data-style-width="d_lostw + '%'"></span></span><span class="v">{{d_hp}}</span></div>
				<div class="stat"><span class="k">EN</span><span class="bar breath"><span class="fill" data-style-width="d_enw + '%'"></span></span><span class="v">{{d_en}}</span></div>
				<div class="stat"><span class="k">MO</span><span class="bar morale"><span class="fill" data-style-width="d_mow + '%'"></span></span><span class="v">{{d_mo}}</span></div>
			</div>
			<div class="acts">
				<button class="icon-btn" id="tac.detail.readout" title="Range &amp; ballistics" data-event-click="readout"><img class="icon" src="icon-chart"/></button>
				<button class="icon-btn" id="tac.detail.swap" title="Swap hands (Ctrl+Q)" data-event-click="swap_hands"><img class="icon" src="icon-swap-hands"/></button>
				<button class="icon-btn" id="tac.detail.mute" title="Mute this merc" data-class-on="d_mute" data-event-click="mute"><img class="icon" src="icon-mute"/></button>
				<button class="icon-btn" id="tac.detail.close" title="Close (`)" data-event-click="detail_close"><img class="icon" src="icon-close"/></button>
			</div>
		</div>
		<div class="body">
			<div class="attrs" id="tac.detail.attrs">
				<div class="row" data-for="a : attrs" data-class-lead="a.lead"><span class="k">{{a.k}}</span><span class="bar"><span class="fill" data-style-width="a.w + '%'"></span></span><span class="v">{{a.v}}</span></div>
			</div>
			<!-- the paper doll: a clay mannequin in a lit recess, each worn slot at the side of the part it dresses, with a
			     leader line to that part (the lines and the figure are decoration, not hit areas) -->
			<div class="doll" id="tac.inv.body">
				<div class="stage audit-skip"></div>
				<img class="figure audit-skip" data-attr-src="d_doll"/>
				<div class="ld audit-skip l-hl"></div><div class="ld audit-skip l-ch"></div><div class="ld audit-skip l-wa"></div><div class="ld audit-skip l-kn"></div>
				<div class="ld audit-skip r-hd"></div><div class="ld audit-skip r-f2a"></div><div class="ld audit-skip r-f2b"></div><div class="ld audit-skip r-f2c"></div>
				<div class="ld audit-skip r-lba"></div><div class="ld audit-skip r-lbb"></div><div class="ld audit-skip r-lbc"></div><div class="ld audit-skip r-pk"></div>
				<div class="ld audit-skip h-l"></div><div class="ld audit-skip h-r"></div>
				<div class="dot audit-skip p-head"></div><div class="dot audit-skip p-chest"></div><div class="dot audit-skip p-waist"></div><div class="dot audit-skip p-knee"></div>
				<div class="dot audit-skip p-head2"></div><div class="dot audit-skip p-chest2"></div><div class="dot audit-skip p-hip"></div><div class="dot audit-skip p-face2"></div>
				<div class="dot audit-skip p-handl"></div><div class="dot audit-skip p-handr"></div>
				<div data-for="s : body" data-attr-class="'slot at-' + s.idx" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
					<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
					<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
					<span class="count" data-if="s.count != ''">{{s.count}}</span>
					<span class="pip" data-if="s.att">{{s.natts}}</span>
					<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
					<span class="lbl">{{s.label}}</span>
					<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
				</div>
				<div data-for="s : lbe" data-attr-class="'slot at-' + s.idx" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
					<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
					<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
					<span class="pip" data-if="s.att">{{s.natts}}</span>
					<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
					<span class="lbl">{{s.label}}</span>
					<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
				</div>
				<div data-for="s : hands" data-attr-class="'slot big at-' + s.idx" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
					<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
					<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
					<span class="count" data-if="s.count != ''">{{s.count}}</span>
					<span class="pip" data-if="s.att">{{s.natts}}</span>
					<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
					<span class="lbl">{{s.label}}</span>
					<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
				</div>
			</div>
			<!-- pockets, grouped by the LBE item that carries them (vest POCK1-4, belt POCK5-8, pack POCK9-12) -->
			<div class="pockets" id="tac.inv.pockets">
				<span class="cap">Vest pockets</span>
				<div class="grid">
					<div data-for="s : big" class="slot" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
						<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
						<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
						<span class="count" data-if="s.count != ''">{{s.count}}</span>
						<span class="pip" data-if="s.att">{{s.natts}}</span>
						<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
						<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
					</div>
				</div>
				<span class="cap">Belt pouches</span>
				<div class="grid">
					<div data-for="s : belt" class="slot" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
						<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
						<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
						<span class="count" data-if="s.count != ''">{{s.count}}</span>
						<span class="pip" data-if="s.att">{{s.natts}}</span>
						<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
						<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
					</div>
				</div>
				<span class="cap">Pack</span>
				<div class="grid">
					<div data-for="s : pack" class="slot" data-attr-id="'tac.inv.slot[' + s.idx + ']'" data-attr-title="s.title" data-event-mouseup="slot(s.idx, ev.button)">
						<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
						<img class="ghost" data-if="s.empty" data-attr-src="'icon-' + s.ghost"/>
						<span class="count" data-if="s.count != ''">{{s.count}}</span>
						<span class="pip" data-if="s.att">{{s.natts}}</span>
						<div class="cond" data-if="!s.empty" data-class-worn="s.worn"><div class="fill" data-style-height="s.cond + '%'"></div></div>
						<div class="card audit-over" data-if="!s.empty"><span class="cn">{{s.title}}</span><div class="cc"><span class="bar ok" data-class-warn="s.worn"><span class="fill" data-style-width="s.cond + '%'"></span></span><span class="v">{{s.cond}}%</span></div><div class="kv"><span class="k">Weight</span><span class="v">{{s.wt}}</span></div><div class="kv" data-if="s.ammo != ''"><span class="k">Ammo</span><span class="v">{{s.ammo}}</span></div><div class="kv" data-if="s.ammo == '' &amp;&amp; s.count != ''"><span class="k">Count</span><span class="v">{{s.count}}</span></div><span class="ch" data-if="s.natts &gt; 0">Attachments</span><div class="atl" data-if="s.natts &gt; 0" data-rml="s.atts"></div></div>
					</div>
				</div>
				<!-- what the kit costs the merc: load, protection, concealment -->
				<div class="gauges">
					<div class="gauge" data-class-over="d_heavy"><span class="k">Load</span><span class="bar"><span class="fill" data-style-width="d_weightw + '%'"></span></span><span class="v">{{d_weight}}</span></div>
					<div class="gauge"><span class="k">Armour</span><span class="bar"><span class="fill" data-style-width="d_armourw + '%'"></span></span><span class="v">{{d_armour}}</span></div>
					<div class="gauge"><span class="k">Camo</span><span class="bar"><span class="fill" data-style-width="d_camow + '%'"></span></span><span class="v">{{d_camo}}</span></div>
				</div>
				<div class="purse">
					<button class="btn" id="tac.inv.money" title="Deposit or withdraw money" data-event-click="money_region"><img class="icon" src="icon-money"/><span class="mono">{{d_money}}</span></button>
					<button class="btn" id="tac.inv.keys" title="Key ring (K)" data-event-click="keyring"><img class="icon" src="icon-key"/><span class="mono">{{d_keys}}</span></button>
				</div>
			</div>
		</div>
		<div class="foot"><span class="kbd">Click</span><span>pick up / put down</span><span class="kbd">RMB</span><span>details</span><span class="kbd">Ctrl+Q</span><span>swap hands</span><span class="kbd">Space</span><span>next merc</span></div>
	</div>

	<!-- item description (right click on an item): the item sheet. A lit picture well with condition and weight,
	     then two pages: General (specs with bars, the magazine, attachments) and Description (the dossier text) -->
	<div class="idesc hud hit" id="tac.desc" data-if="desc">
		<div class="hud-head"><span class="t" id="tac.desc.name">{{x_name}}</span><span class="tag" data-if="x_type != ''">{{x_type}}</span><div class="grow"></div>
			<button class="icon-btn" id="tac.desc.close" title="Close (right click)" data-event-click="desc_done"><img class="icon" src="icon-close"/></button></div>
		<div class="pic-area" id="tac.desc.picture"><img class="pic" data-attr-src="x_pic" data-style-width="x_pw + 'px'" data-style-height="x_ph + 'px'"/>
			<div class="chip c-l" data-if="!desc_money"><span class="k">{{x_status_label}}</span><span class="v">{{x_status}}</span></div>
			<div class="chip c-r" data-if="!desc_money"><img class="icon sm" src="icon-weight"/><span class="v">{{x_weight}}</span></div>
		</div>
		<div class="tabs" data-if="!desc_money">
			<span class="tab" id="tac.desc.tab.general" data-class-active="x_tab == 'general'" data-event-click="desc_tab('general')">General</span>
			<span class="tab" id="tac.desc.tab.desc" data-class-active="x_tab == 'desc'" data-event-click="desc_tab('desc')">Description</span>
		</div>
		<div class="cols" data-if="!desc_money &amp;&amp; x_tab == 'general'">
			<div class="c">
				<span class="cap">{{l_weapon}}</span>
				<div class="spec" data-for="k : x_stats" data-class-low="k.low"><img class="icon" data-attr-src="'icon-' + k.icon"/><span class="k">{{k.k}}</span><span class="bar"><span class="fill" data-style-width="k.w + '%'"></span></span><span class="v">{{k.v}}</span></div>
				<div class="spec cond-row"><img class="icon" src="icon-repair"/><span class="k">{{x_status_label}}</span><span class="bar ok"><span class="fill" data-style-width="x_cond + '%'"></span></span><span class="v" id="tac.desc.status">{{x_status}}</span></div>
				<span class="fits" data-if="x_key != ''">{{x_key}}</span>
			</div>
			<div class="c last" data-if="desc_weapon || desc_gun">
				<div data-if="desc_gun">
					<span class="cap">{{l_ammo}}</span>
					<div class="ammo" id="tac.desc.ammo"><div class="a"><span class="n" id="tac.desc.rounds">{{x_ammo}}</span><span class="t">{{x_ammo_type}}</span></div>
						<button class="btn" id="tac.desc.unload" title="Take the magazine out" data-event-click="unload"><img class="icon sm" src="icon-reload"/><span class="label">{{l_unload}}</span></button></div>
				</div>
				<span class="cap">{{l_attachments}}</span>
				<div class="atts" id="tac.desc.atts">
					<div class="slot" data-for="s : x_atts" data-attr-id="'tac.desc.att[' + s.idx + ']'" data-attr-title="s.title" data-class-is-disabled="desc_hatched" data-event-mouseup="att(s.idx, ev.button)">
						<div class="item" data-if="!s.empty"><img class="pic" data-attr-src="s.src" data-style-width="s.w + 'px'" data-style-height="s.h + 'px'"/></div>
						<img class="ghost" data-if="s.empty" src="icon-add"/>
						<div class="cond" data-if="!s.empty"><div class="fill" data-style-height="s.cond + '%'"></div></div>
						<span class="lbl">{{s.label}}</span>
					</div>
				</div>
			</div>
		</div>
		<div class="dossier" data-if="!desc_money &amp;&amp; x_tab == 'desc'">
			<span class="text">{{x_text}}</span>
			<div class="pc" data-if="desc_pros_cons"><span class="k pro">{{l_pros}}</span><span class="v">{{x_pros}}</span></div>
			<div class="pc" data-if="desc_pros_cons"><span class="k con">{{l_cons}}</span><span class="v">{{x_cons}}</span></div>
		</div>
		<div class="money-split" data-if="desc_money" id="tac.money">
			<div class="kv"><span class="k">Amount</span><span class="v" id="tac.money.total">{{m_total}}</span></div>
			<div class="kv"><span class="k">Remaining</span><span class="v" id="tac.money.remaining">{{m_remaining}}</span></div>
			<div class="amt"><span id="tac.money.amount">{{m_removing}}</span></div>
			<div class="chips">
				<button class="btn" id="tac.money.add1000" data-class-is-disabled="!m_1000" title="Right click: take back" data-event-mouseup="money(0, ev.button)"><span class="label">+1000</span></button>
				<button class="btn" id="tac.money.add100" data-class-is-disabled="!m_100" title="Right click: take back" data-event-mouseup="money(1, ev.button)"><span class="label">+100</span></button>
				<button class="btn" id="tac.money.add10" data-class-is-disabled="!m_10" title="Right click: take back" data-event-mouseup="money(2, ev.button)"><span class="label">+10</span></button>
			</div>
		</div>
		<div class="foot"><div class="grow"></div><button class="btn btn-primary" id="tac.desc.done" data-event-click="desc_done"><span class="label">{{l_done}}</span></button></div>
	</div>

	<!-- the question a move asked (merge two items, mount an attachment that cannot come off again) -->
	<div class="ask hud hit" id="tac.ask" data-if="ask">
		<span class="text" id="tac.ask.text">{{ask_text}}</span>
		<div class="foot"><div class="grow"></div>
			<button class="btn" id="tac.ask.no" data-event-click="ask_no"><span class="label">{{l_no}}</span></button>
			<button class="btn btn-primary" id="tac.ask.yes" data-event-click="ask_yes"><span class="label">{{l_yes}}</span></button></div>
	</div>

	<div class="ask-hint" id="tac.hint" data-if="hint != ''"><span>{{hint}}</span></div>

	<!-- squad bar -->
	<div class="sbar hit" id="tac.bar">
		<div class="squads" id="tac.squadtabs">
			<div class="sq" data-for="q : squads" data-class-on="q.on" data-attr-id="'tac.squadtab[' + q.n + ']'" data-event-click="squad(q.n)"><span>{{q.n}}</span><span class="n">{{q.count}}</span></div>
			<div class="sq" id="tac.squadtab.next" title="Next squad (Shift+Space)" data-event-click="next_squad"><img class="icon sm" src="icon-chevron-down"/></div>
		</div>
		<div class="cards" id="tac.squad">
			<div class="tcard" data-for="c : cards" data-attr-id="'tac.squad[' + c.slot + ']'" data-class-ghost="c.empty" data-class-sel="c.sel" data-class-done="c.done" data-class-crit="c.crit" data-class-talking="c.talking" data-event-click="select(c.slot)" data-event-dblclick="details(c.slot)">
				<span data-if="c.empty" class="empty-label"> </span>
				<div class="face" data-if="!c.empty"><img class="pic" data-attr-src="c.face" data-style-width="c.fw + 'px'" data-style-height="c.fh + 'px'"/><div class="ap" data-if="combat"><span class="k">AP </span>{{c.ap}}</div><img class="spk" data-if="c.talking" src="icon-talk"/></div>
				<div class="info" data-if="!c.empty">
					<div class="nr"><span class="nm">{{c.name}}</span><img class="icon danger" data-if="c.bleeding" src="icon-bleeding" title="Bleeding"/><img class="icon info" data-if="c.asleep" src="icon-asleep" title="Asleep"/><img class="icon info" data-if="c.stealth" src="icon-sneak" title="Stealth"/><img class="icon" data-if="c.drunk" src="icon-drunk" title="Drunk"/></div>
					<span class="sub">{{c.sub}}</span>
					<div class="st"><span class="k">HP</span><div class="bar hp"><div class="fill" data-style-width="c.hpw + '%'"></div><div class="lost" data-style-width="c.lostw + '%'"></div></div><span class="v">{{c.hp}}</span></div>
					<div class="st"><span class="k">EN</span><div class="bar breath"><div class="fill" data-style-width="c.en + '%'"></div></div><span class="v">{{c.en}}</span></div>
					<div class="st"><span class="k">MO</span><div class="bar morale"><div class="fill" data-style-width="c.mo + '%'"></div></div><span class="v">{{c.mo}}</span></div>
					<div class="hand" data-attr-title="c.hand_name"><img class="pic" data-if="c.hand != ''" data-attr-src="c.hand" data-style-width="c.hw + 'px'" data-style-height="c.hh + 'px'"/><span class="am" data-class-low="c.low">{{c.ammo}}</span></div>
				</div>
			</div>
		</div>
		<div class="tools" id="tac.tools">
			<div class="row">
				<button class="icon-btn" id="tac.stance.stand" title="Stand (S)" data-class-on="stance == 'stand'" data-event-click="key('s')"><img class="icon" src="icon-stance-stand"/><span class="kk">S</span></button>
				<button class="icon-btn" id="tac.stance.crouch" title="Crouch (C)" data-class-on="stance == 'crouch'" data-event-click="key('c')"><img class="icon" src="icon-stance-crouch"/><span class="kk">C</span></button>
				<button class="icon-btn" id="tac.stance.prone" title="Prone (P)" data-class-on="stance == 'prone'" data-event-click="key('p')"><img class="icon" src="icon-stance-prone"/><span class="kk">P</span></button>
				<div class="sep"></div>
				<button class="icon-btn" id="tac.move.run" title="Run (R)" data-class-on="run" data-event-click="key('r')"><img class="icon" src="icon-run"/><span class="kk">R</span></button>
				<button class="icon-btn" id="tac.stealth" title="Stealth mode (Z)" data-class-on="stealth" data-event-click="key('z')"><img class="icon" src="icon-sneak"/><span class="kk">Z</span></button>
			</div>
			<div class="row">
				<button class="icon-btn" id="tac.burst" title="Burst fire (B)" data-class-on="burst" data-event-click="key('b')"><img class="icon" src="icon-burst"/><span class="kk">B</span></button>
				<button class="icon-btn" id="tac.look" title="Look / turn (L)" data-event-click="key('l')"><img class="icon" src="icon-look"/><span class="kk">L</span></button>
				<button class="icon-btn" id="tac.talk" title="Talk" data-event-click="talk"><img class="icon" src="icon-talk"/></button>
				<div class="sep"></div>
				<button class="icon-btn" id="tac.climb" title="Climb (J)" data-event-click="key('j')"><img class="icon" src="icon-climb"/><span class="kk">J</span></button>
				<button class="icon-btn" id="tac.level" title="View roof level (Tab)" data-class-on="roof" data-event-click="key('tab')"><img class="icon" src="icon-chevron-up"/><span class="kk">Tab</span></button>
			</div>
		</div>
		<div class="sys" id="tac.sys">
			<button class="btn" id="tac.endturn" data-class-btn-primary="can_end" data-attr-title="combat ? 'End your turn (D)' : 'Start turn-based combat (D)'" data-event-click="key('d')"><img class="icon" src="icon-end-turn"/><span class="label" data-if="combat">{{l_end_turn}}</span><span class="label" data-if="!combat">{{l_turn_based}}</span><span class="kbd">D</span></button>
			<button class="btn" id="tac.map" title="Strategic map (M)" data-event-click="key('m')"><img class="icon" src="icon-map"/><span class="label">{{l_map}}</span><span class="kbd">M</span></button>
			<div class="row"><button class="icon-btn" id="tac.inventory" title="Merc details and inventory (`)" data-event-click="key('grave')"><img class="icon" src="icon-inventory"/></button><button class="icon-btn" id="tac.logbtn" title="Message log (H)" data-event-click="log"><img class="icon" src="icon-menu"/></button><button class="icon-btn last" id="tac.options" title="Options (O)" data-event-click="options"><img class="icon" src="icon-options"/></button></div>
		</div>
	</div>

	<!-- the action menu (right click hold) and the door menu (clicking a door): they press the legacy buttons -->
	<div class="scrim hit audit-over" data-if="menu_open" data-event-click="menu_cancel"></div>
	<div class="pop hit audit-over" id="tac.menu" data-if="menu_open" data-style-left="menu_x + 'px'" data-style-top="menu_y + 'px'">
		<div class="menu">
			<div class="menu-title"><span class="t">{{menu_title}}</span><span class="m">{{menu_sub}}</span></div>
			<div data-for="m : menu" data-attr-id="m.eid" data-class-menu-item="m.kind == 'item'" data-class-menu-head="m.kind == 'head'" data-class-menu-sep="m.kind == 'sep'" data-class-is-disabled="m.disabled" data-attr-title="m.title" data-event-click="menu_item(m.id)">
				<img class="icon" data-if="m.kind == 'item'" data-attr-src="'icon-' + m.icon"/>
				<span class="label">{{m.label}}</span>
				<span class="kbd" data-if="m.kbd != ''">{{m.kbd}}</span>
				<span class="ap" data-if="m.kind == 'item' &amp;&amp; m.ap >= 0">{{m.ap}} AP</span>
				<span class="why" data-if="m.why != ''">{{m.why}}</span>
			</div>
		</div>
	</div>

	<!-- the pick-up menu (items on the ground): the same rows and rules as the legacy list -->
	<div class="scrim hit audit-over" data-if="pick_open"></div>
	<div class="pop pick hit audit-over" id="tac.pickup" data-if="pick_open" data-style-left="pick_x + 'px'" data-style-top="pick_y + 'px'">
		<div class="hud-head"><img class="icon sm" src="icon-sector-inventory"/><span class="t">{{pick_title}}</span><span class="m">{{pick_sub}}</span></div>
		<div class="rows">
			<div class="prow" data-for="p : pick" data-attr-id="p.eid" data-class-on="p.sel" data-attr-title="p.title" data-event-click="pick_item(p.slot)" data-event-mouseover="pick_hover(p.slot)" data-event-mouseout="pick_hover(-1)">
				<div class="chk" data-class-on="p.sel"><img class="icon" src="icon-confirm"/></div>
				<div class="pbox"><img class="pic" data-if="!p.empty" data-attr-src="p.src" data-style-width="p.w + 'px'" data-style-height="p.h + 'px'"/></div>
				<span class="n">{{p.name}}</span>
				<img class="att" data-if="p.att" src="icon-add"/>
				<span class="q">{{p.count}}</span>
			</div>
		</div>
		<div class="foot">
			<button class="btn" id="tac.pickup.all" data-class-on="pick_all" title="Take or drop everything" data-event-click="pick_all"><span class="label">All</span></button>
			<button class="icon-btn" data-if="pick_pages > 1" id="tac.pickup.up" data-class-is-disabled="!pick_can_up" title="Previous page" data-event-click="pick_scroll(-1)"><img class="icon" src="icon-chevron-up"/></button>
			<button class="icon-btn" data-if="pick_pages > 1" id="tac.pickup.down" data-class-is-disabled="!pick_can_down" title="Next page" data-event-click="pick_scroll(1)"><img class="icon" src="icon-chevron-down"/></button>
			<div class="grow"></div>
			<button class="btn" id="tac.pickup.cancel" title="Close (Esc)" data-event-click="pick_cancel"><span class="label">Cancel</span></button>
			<button class="btn btn-primary" id="tac.pickup.ok" data-class-is-disabled="!pick_ok_enabled" data-event-click="pick_ok"><span class="label">{{pick_ok}}</span></button>
		</div>
	</div>
</div>
</body>
</rml>
