/* The native credits screen (credits.rml, docs/ui/credits.md). 1920x1080 dp reference; down to 1280x720 dp the team
 * column narrows and its roster scrolls. */
body.screen-credits { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--c-void); }
#credits { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.cr-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: image(gen-topo repeat); opacity: 0.8; }

/* header: title left, actions right */
.cr-head {
	position: absolute; left: 0; top: 0; right: 0; height: 104dp; padding: 0 var(--sp-7);
	display: flex; align-items: center; border-bottom: var(--border) var(--c-line); background-color: var(--c-bg);
}
.cr-heading { display: block; flex: 1 1 0; }
.cr-kicker { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-sm); text-transform: uppercase; color: var(--c-accent); letter-spacing: 2dp; }
.cr-title { display: block; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-2xl); text-transform: uppercase; color: var(--c-text-strong); line-height: 40dp; }
.cr-actions { display: flex; align-items: center; }
.cr-actions .btn { margin-left: var(--sp-3); }

/* the two columns */
.cr-main { position: absolute; left: 0; top: 104dp; right: 0; bottom: 0; padding: var(--sp-5) var(--sp-7) var(--sp-6) var(--sp-7); display: flex; }
.cr-team { display: flex; flex-direction: column; flex: 0 0 43%; margin-right: var(--sp-6); }
.cr-section { display: block; flex: 0 0 auto; margin-bottom: var(--sp-3); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-sm); text-transform: uppercase; color: var(--c-text-dim); }

/* the team: three columns of people */
.cr-roster { display: flex; flex-wrap: wrap; align-content: flex-start; flex: 1 1 0; }
.cr-person {
	display: flex; align-items: center; box-sizing: border-box; width: 33.33%; height: 120dp; padding: var(--sp-2);
	border: var(--border) #00000000; border-radius: var(--r-1);
	focus: auto; tab-index: auto; nav: auto;
	transition: background-color border-color var(--t-fast) var(--ease);
}
.cr-person:hover, .cr-person.selected { background-color: var(--c-panel-2); border-color: var(--c-line-2); }
.cr-person.selected { border-color: var(--c-select); }
.cr-person:focus-visible { border: var(--focus-ring) var(--c-focus); }
.cr-face {
	display: block; flex: 0 0 auto; width: 66dp; height: 88dp; margin-right: var(--sp-3);
	background-color: var(--c-panel-3); border: var(--border) var(--c-line-2); border-radius: var(--r-1); overflow: hidden;
}
.cr-portrait { display: block; width: 66dp; height: 88dp; }
.cr-who { display: block; flex: 1 1 0; }
.cr-name { display: block; font-weight: 600; font-size: var(--fs-md); color: var(--c-text-strong); line-height: 22dp; }
.cr-role { display: block; font-size: var(--fs-xs); color: var(--c-text-dim); line-height: 17dp; }
.cr-person.selected .cr-name { color: var(--c-select); }

/* who is pointed at */
.cr-detail {
	display: block; flex: 0 0 auto; min-height: 118dp; margin-top: var(--sp-4); padding: var(--sp-4) var(--sp-5); box-sizing: border-box;
	background-color: var(--c-panel); border: var(--border) var(--c-line); border-left: 3dp var(--c-select); border-radius: var(--r-2);
}
.cr-detail.empty { border-left-color: var(--c-line-2); }
.cr-detail-name { display: block; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-xl); text-transform: uppercase; color: var(--c-text-strong); line-height: 32dp; }
.cr-detail.empty .cr-detail-name { font-family: var(--font-body); font-weight: 400; text-transform: none; font-size: var(--fs-md); color: var(--c-text-dim); }
.cr-detail-title { display: block; font-size: var(--fs-sm); color: var(--c-accent); line-height: 22dp; }
.cr-detail-funny { display: block; margin-top: var(--sp-2); font-size: var(--fs-md); color: var(--c-text); line-height: 24dp; }

/* the reel: the credits file scrolling up through a framed window */
.cr-reel-frame {
	display: block; position: relative; flex: 1 1 0;
	background-color: var(--c-bg); border: var(--border) var(--c-line); border-radius: var(--r-2);
}
.cr-reel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; clip: always; }
.cr-reel-content { position: absolute; left: var(--sp-7); right: var(--sp-7); top: 0; text-align: center; }
.cr-t {
	display: block; margin-top: var(--sp-6); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg);
	text-transform: uppercase; color: var(--c-accent); line-height: 30dp; letter-spacing: 1dp;
}
.cr-l { display: block; font-size: var(--fs-lg); color: var(--c-text-strong); line-height: 30dp; }
.cr-g { display: block; height: var(--sp-7); }
.cr-fade { position: absolute; left: 0; width: 100%; height: 96dp; image-color: var(--c-bg); }
.cr-fade.top { top: 0; }
.cr-fade.bottom { bottom: 0; }
.cr-paused {
	display: flex; align-items: center; position: absolute; right: var(--sp-4); top: var(--sp-4); padding: 0 var(--sp-3); height: 28dp;
	background-color: var(--c-panel-3); border: var(--border) var(--c-line-2); border-radius: var(--r-1);
	font-family: var(--font-display); font-weight: 600; font-size: var(--fs-sm); text-transform: uppercase; color: var(--c-text);
}
.cr-paused .icon { margin-right: var(--sp-2); image-color: var(--c-warn); }

/* narrow layouts (below 1600 dp, set by the screen): two columns of people, a wider team column */
#credits.compact .cr-team { flex-basis: 46%; }
#credits.compact .cr-person { width: 50%; }
