/* Save/load spike screen. Units are dp: 1dp = 1px at 1920x1080, scaled with the window (see UiSpike.h). */

/* RmlUi has no user-agent stylesheet: every element is inline until told otherwise. */
div, p, h1, h2 { display: block; }

body, #root {
	width: 100%;
	height: 100%;
	margin: 0;
}
body {
	background-color: #101418;
	font-family: Lato;
	font-weight: normal;
	font-size: 18dp;
	color: #e6e9ec;
}

#panel {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 1200dp;
	height: 860dp;
	margin-left: -600dp;
	margin-top: -430dp;
	background-color: #1b2229;
	border: 1dp #2c3640;
	border-radius: 10dp;
	display: flex;
	flex-direction: column;
	padding: 28dp 32dp;
	box-sizing: border-box;
}

#header { display: flex; align-items: baseline; margin-bottom: 18dp; }
h1 { font-size: 34dp; font-weight: bold; color: #f2f4f5; flex: 1; }
.count { color: #8d99a6; }

#columns {
	display: flex;
	padding: 0 16dp 8dp 20dp;
	color: #8d99a6;
	font-size: 15dp;
	border-bottom: 1dp #2c3640;
}

.c-name  { flex: 1; }
.c-where { width: 230dp; }
.c-when  { width: 180dp; }
.c-money { width: 130dp; text-align: right; }

#list {
	flex: 1;
	overflow-y: auto;
	margin-top: 6dp;
}

.row {
	display: flex;
	align-items: center;
	height: 46dp;
	padding: 0 16dp 0 17dp;
	border-left: 3dp transparent;
	border-radius: 4dp;
}
.row:nth-child(odd) { background-color: #1f272f; }
.row:hover { background-color: #26313b; }
.row.selected { background-color: #3a3220; border-left-color: #d9a441; }
.row .c-where, .row .c-when { color: #aeb8c2; }
.row .c-money { color: #b9d99a; }

scrollbarvertical { width: 12dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: #151b20; border-radius: 6dp; }
scrollbarvertical sliderbar { background-color: #3b4957; border-radius: 6dp; min-height: 40dp; }
scrollbarvertical sliderbar:hover { background-color: #52667a; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

#footer {
	display: flex;
	align-items: center;
	margin-top: 18dp;
	padding-top: 18dp;
	border-top: 1dp #2c3640;
}
#status { flex: 1; color: #8d99a6; }

.btn {
	display: block;
	padding: 10dp 22dp;
	margin-left: 12dp;
	border-radius: 6dp;
	background-color: #2c3640;
	color: #e6e9ec;
	font-weight: bold;
	text-align: center;
}
.btn:hover { background-color: #3a4652; }
.btn:active { background-color: #222a32; }
.btn.primary { background-color: #d9a441; color: #1b1406; }
.btn.primary:hover { background-color: #e8b654; }
.btn.danger { background-color: #8e3a2a; }
.btn.danger:hover { background-color: #a8472f; }
.btn.disabled, .btn.disabled:hover { background-color: #232b33; color: #5c6772; }
kbd { font-weight: normal; font-size: 14dp; opacity: 0.7; margin-left: 6dp; }

#tooltip {
	position: absolute;
	max-width: 420dp;
	padding: 8dp 12dp;
	background-color: #f2f4f5;
	color: #101418;
	font-size: 16dp;
	border-radius: 5dp;
}

#backdrop {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	background-color: #000000a8;
}
#modal {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 560dp;
	margin-left: -280dp;
	margin-top: -120dp;
	padding: 28dp 32dp;
	box-sizing: border-box;
	background-color: #1f272f;
	border: 1dp #3b4957;
	border-radius: 10dp;
}
h2 { font-size: 26dp; font-weight: bold; margin-bottom: 12dp; }
#modal p { color: #aeb8c2; margin-bottom: 26dp; }
.actions { display: flex; justify-content: flex-end; }
